# Copy to .env next to docker-compose.yml. .env is gitignored, never commit it.

# Leave empty to show the name the server reports
LONGHOUSE_SERVER_NAME=
LONGHOUSE_TIMEZONE=America/New_York
# Where the dashboard listens on the host; point your tunnel's public hostname here
LONGHOUSE_BIND=127.0.0.1:8080

# Must match the Valheim container
VALHEIM_CONTAINER=valheim
VALHEIM_QUERY_PORT=2457
VALHEIM_MAX_PLAYERS=10

# Bosses your group has beaten (Valheim 1.0 worlds can't be read for this):
# eikthyr,elder,bonemass,moder,yagluth,queen,fader
LONGHOUSE_BOSSES=

# Optional
LONGHOUSE_PASSWORD=
LONGHOUSE_HIDDEN_PLAYERS=

# Only for `docker compose --profile tunnel up -d`: Zero Trust > Networks > Tunnels > Docker token
TUNNEL_TOKEN=
