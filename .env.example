# copy to .env and fill in. .env is gitignored, don't commit it
# Deploying next to a Valheim container with a Cloudflare Tunnel? Use deploy/.env.example instead.

# Leave empty to show the name the server reports over the Steam query port
LONGHOUSE_SERVER_NAME=
LONGHOUSE_PORT=8080
LONGHOUSE_TIMEZONE=UTC
LONGHOUSE_REFRESH_SECONDS=15

# Where the game server is
VALHEIM_HOST=host.docker.internal
VALHEIM_QUERY_PORT=2457
VALHEIM_MAX_PLAYERS=10
VALHEIM_CONTAINER=valheim
DOCKER_HOST=unix:///var/run/docker.sock
VALHEIM_WORLDS_DIR=/valheim/worlds_local
VALHEIM_WORLD=
VALHEIM_SAVE_INTERVAL=1800
# Read a log file instead of the Docker API (leave empty for Docker)
VALHEIM_LOG_PATH=

# Privacy
LONGHOUSE_PASSWORD=
LONGHOUSE_HIDE_ADDRESS=true
LONGHOUSE_HIDDEN_PLAYERS=
# Boss progress set by hand when the world file isn't mounted, e.g. eikthyr,elder
LONGHOUSE_BOSSES=
